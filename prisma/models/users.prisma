model User {
  id         String   @id @default(uuid(7)) @db.Uuid
  username   String
  email      String   @unique
  password   String
  real_name  String
  avatar     String
  is_enable  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  is_deleted Boolean  @default(false)
  todos      Todos[]

  @@map("users")
}
